# Copy to .env and fill in. Required to run scripts/deploy_audit_anchor.ts
# against Base Sepolia — not required for local/simulated-network tests
# (`npx hardhat test`), which need none of this.

# Coinbase Developer Platform credentials — same three vars the backend
# uses (backend/.env), same CDP project. Get these from
# https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Named CDP server wallet that deploys AuditAnchor.sol and is the only
# address ever authorized to call anchor() afterward. Must match the
# backend's AUDIT_BACKEND_WALLET_NAME (backend/.env) — same account,
# same name, resolved independently by both sides via
# cdp.evm.get_or_create_account(name=...) (Python) / getOrCreateAccount
# (TypeScript).
AUDIT_BACKEND_WALLET_NAME=inuka-audit-backend

# Base Sepolia RPC endpoint.
BASE_RPC_URL=https://sepolia.base.org
