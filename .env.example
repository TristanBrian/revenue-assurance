# ============================================================================
# KPC REVENUE ASSURANCE – ENVIRONMENT VARIABLES
# ============================================================================

# --- Application ---
APP_NAME=KPC Revenue Assurance API
APP_VERSION=2.0.0
APP_ENV=development

# --- Database ---
# Read by backend/app/config.py from a .env file at the REPO ROOT (copy this file to .env here, not into backend/)
# PostgreSQL — REQUIRED if you want auth/RBAC to work: users/roles/permissions
# use Postgres-native UUID columns, unsupported by SQLite. Any Postgres
# instance works, doesn't have to be your system one (see AUTH_NOTES.md).
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/kpc_db
# SQLite (zero setup, but auth/RBAC tables can't be created against it —
# only reconciliation/e-billing/heatmap/graph/feed will work)
# DATABASE_URL=sqlite:///./kpc.db

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- KRA iCMS Simulation (E-Billing) ---
KRA_ICMS_ENDPOINT=https://api.kra.go.ke/icms/v2/invoices
KRA_ICMS_API_KEY=test-api-key-12345
KRA_ICMS_TIMEOUT=30

# --- Reconciliation ---
MATERIALITY_THRESHOLD=100000        # KSh – only flag leaks above this
CRITICAL_AGE_DAYS=60                # Days after which pending becomes critical

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# --- Security (REQUIRED — app/core/security.py reads SECRET_KEY directly
# from the environment and fails to import without it, not just in prod) ---
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Alerts / Notifications (app/core/email.py) ---
# Optional: if any of SMTP_HOST/SMTP_USER/SMTP_PASSWORD are unset, the app
# still runs — in-app alerts still work, email sending is just skipped
# (logged as a warning) instead of raising. For Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USER=your address, SMTP_PASSWORD=a 16-char Google
# "App Password" (myaccount.google.com/apppasswords — requires 2FA enabled
# on the account), NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_FROM_NAME=KPC Revenue Assurance

# --- Immutable Audit Trail: On-Chain Anchor (app/services/audit/anchor_service.py) ---
# Optional: without these, the audit trail's off-chain hash chain (every
# ingested record + every in-platform action, chained and tamper-evident
# in Postgres) still works fully — GET /api/audit/verify's local_chain
# check is unaffected. Only the periodic on-chain anchor to Base Sepolia
# (the second, independently-verifiable check) is skipped, logged, not
# an error — same "not configured" posture as the SMTP_* vars above.
# Deploy web3/contracts/AuditAnchor.sol first (see web3/README.md) to get
# AUDIT_ANCHOR_CONTRACT_ADDRESS_V2. AUDIT_ANCHOR_CONTRACT_ADDRESS (no
# suffix) is the original per-row-chain contract (V1) — only needed if
# you have pre-cutover on-chain anchors to keep resolving; see
# backend/docs/audit-merkle-migration.md.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
BASE_RPC_URL=https://sepolia.base.org
AUDIT_ANCHOR_CONTRACT_ADDRESS=
AUDIT_ANCHOR_CONTRACT_ADDRESS_V2=
AUDIT_BACKEND_WALLET_NAME=inuka-audit-backend