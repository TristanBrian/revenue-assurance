{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "NEXT_PUBLIC_API_URL": "https://revenue-assurance.fly.dev",
        "EXPO_PUBLIC_API_URL": "https://revenue-assurance.fly.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

